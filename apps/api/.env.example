SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ENVIRONMENT=development

# Development only: pass X-Dealership-Id header on /api/v1/* requests.
# Run: python scripts/seed_test_dealership.py

# Sync adapters (default stub until Minew gateway push is validated)
RENDERER_ADAPTER=stub
TRANSPORT_ADAPTER=stub

# Minew G1-E MQTT (gateway on LAN) — MACs: 12 chars, uppercase, no colons
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
GATEWAY_MAC=
ESL_TAG_MAC=

# Optional Minew protocol overrides (defaults match first integration hypothesis)
MINEW_MQTT_TOPIC_PREFIX=Mqtt/GateWay
MINEW_MQTT_TOPIC_SUFFIX=Command
MINEW_MQTT_SUBSCRIBE_TOPIC=#
MINEW_MQTT_TOPIC=
MINEW_MQTT_CLIENT_ID=lotsync
MINEW_MQTT_MSG_TYPE=dData
MINEW_MQTT_AUTH1=00000000
MINEW_MQTT_DTYPE=ascii
MINEW_JENGINE_COMMAND=02
MINEW_JENGINE_DATA_ENCODING=command02_v1
